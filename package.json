{
  "name": "semantic-typescript",
  "author": {
    "name": "Eloy Kim",
    "email": "eloy.kim@outlook.com",
    "url": "https://github.com/eloyhere"
  },
  "description": "A modern type-safe stream processing library inspired by JavaScript Generator, Java Stream, and MySQL Index. Supports lazy evaluation, async streams, statistics, and IO-like operations.",
  "version": "2.0.0",
  "type": "module",
  "readme": "readme.md",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./signal": {
      "types": "./dist/synchronous/signal.d.ts",
      "import": "./dist/synchronous/signal.js",
      "require": "./dist/synchronous/signal.js"
    },
    "./distribution": {
      "types": "./dist/synchronous/distribution.d.ts",
      "import": "./dist/synchronous/distribution.js",
      "require": "./dist/synchronous/distribution.js"
    },
    "./statistics": {
      "types": "./dist/synchronous/statistics.d.ts",
      "import": "./dist/synchronous/statistics.js",
      "require": "./dist/synchronous/statistics.js"
    },
    "./window": {
      "types": "./dist/synchronous/window.d.ts",
      "import": "./dist/synchronous/window.js",
      "require": "./dist/synchronous/window.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "imports": {
    "#semantic/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "typescript",
    "stream",
    "async-stream",
    "functional-programming",
    "lazy-evaluation",
    "data-processing",
    "pipeline",
    "statistics",
    "generator",
    "optional",
    "blob-stream",
    "websocket-stream",
    "frontend",
    "bigInt",
    "semantic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloyhere/semantic-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/eloyhere/semantic-typescript/issues"
  },
  "homepage": "https://github.com/eloyhere/semantic-typescript#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
